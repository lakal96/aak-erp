# Custom production image — ERPNext v15 + aak_agency app
# Build: docker build -f images/custom/Containerfile -t ghcr.io/lakal96/aak-erp:latest .
# Based on official frappe_docker custom image pattern.

ARG ERPNEXT_VERSION=v15.66.4
FROM ghcr.io/frappe/erpnext:${ERPNEXT_VERSION}

USER root

# Copy the custom app into the image
COPY apps/aak_agency /home/frappe/frappe-bench/apps/aak_agency

# Install Python dependencies for the custom app
RUN cd /home/frappe/frappe-bench && \
    /home/frappe/frappe-bench/env/bin/pip install \
      --no-cache-dir \
      -r apps/aak_agency/requirements.txt

# Register app in bench apps list
RUN echo "aak_agency" >> /home/frappe/frappe-bench/sites/apps.txt || true

USER frappe
