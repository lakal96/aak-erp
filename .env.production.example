# ─────────────────────────────────────────────
#  AAK Agency ERP — Production Environment
#  Copy this to .env and fill in real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────

# ERPNext version to deploy
ERPNEXT_VERSION=v15.66.4

# Custom image built from apps.json (see docs/build-custom-image.md)
CUSTOM_IMAGE=ghcr.io/lakal96/aak-erp
CUSTOM_TAG=latest

# ── Database ────────────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password_here
# External DB (leave blank to use the bundled MariaDB container)
DB_HOST=
DB_PORT=

# ── Redis (leave blank to use bundled Redis) ─
REDIS_CACHE=
REDIS_QUEUE=

# ── Site & domain ───────────────────────────
FRAPPE_SITE_NAME_HEADER=erp.aakagency.lk
LETSENCRYPT_EMAIL=kapila@aakagency.lk

# ── Gunicorn workers (t3.large = 2 vCPU) ────
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ── Traefik SSL ──────────────────────────────
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# ── AWS S3 Backup ────────────────────────────
S3_BUCKET=aak-erp-backups
AWS_REGION=ap-south-1

# ── Notify.lk SMS (for OTP) ─────────────────
NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=AAKAgency

# ── Nginx tuning ─────────────────────────────
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

# ── Pull policy ──────────────────────────────
PULL_POLICY=always
RESTART_POLICY=unless-stopped
