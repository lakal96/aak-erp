{
  "name": "Delivery Stop",
  "module": "Delivery Management",
  "doctype": "DocType",
  "istable": 1,
  "fields": [
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "options": "Customer",
      "label": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Customer Name",
      "fetch_from": "customer.customer_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "delivery_note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "label": "Delivery Note"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nDelivered\nPartial\nReturned",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "payment_collected",
      "fieldtype": "Currency",
      "label": "Payment Collected",
      "in_list_view": 1
    },
    {
      "fieldname": "payment_method",
      "fieldtype": "Select",
      "label": "Payment Method",
      "options": "\nCash\nCheque\nCredit"
    },
    {
      "fieldname": "cheque_number",
      "fieldtype": "Data",
      "label": "Cheque Number",
      "depends_on": "eval:doc.payment_method == 'Cheque'"
    },
    {
      "fieldname": "delivered_at",
      "fieldtype": "Datetime",
      "label": "Delivered At",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ]
}
