# Copy this to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to Git.

project_name        = "aak-erp"
aws_region          = "ap-south-1"
instance_type       = "t3.large"
root_volume_size_gb = 50
s3_backup_bucket    = "aak-erp-backups"

# Your SSH public key (cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... your-key-here"

# Restrict to your IP for security: ["203.0.113.10/32"]
ssh_allowed_cidrs = ["0.0.0.0/0"]
